# Ports (local 4201/4202, dev 4101/4102, prod 4001/4002; compose files set these for Docker)
PORT_API=4201
PORT_BATCH=4202

# MongoDB Configuration
MONGODB_URI=...

SECRET_TOKEN=...

PUPPETEER_CACHE_DIR=/root/.cache/puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# AI/LLM Configuration 
GEMINI_API_KEY=...

# Web crawling is disabled unless explicitly enabled.
WEB_CRAWLING_ENABLED=false
